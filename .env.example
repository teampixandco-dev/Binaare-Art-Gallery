# =============================================================================
# Binaare Art Gallery — Environment Configuration
# =============================================================================

# Server Port (default: 3000)
PORT=3000

# Gallery Data Storage (SQLite database & uploaded media directory)
# BINAARE_DATA_DIR=./data

# =============================================================================
# Transactional Email Service (Nodemailer / SMTP)
# All contact inquiries are sent to: Binari.gamage@binaareartgallery.com
# =============================================================================

# Option A: cPanel / Dedicated Webmail (e.g. mail.binaareartgallery.com)
SMTP_HOST=mail.binaareartgallery.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=Binari.gamage@binaareartgallery.com
SMTP_PASS=YourEmailPasswordHere
SMTP_FROM="Binaare Art Gallery" <Binari.gamage@binaareartgallery.com>

# Option B: SendGrid / Resend / Amazon SES
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=your-sendgrid-api-key
# SMTP_FROM="Binaare Art Gallery" <notifications@binaareartgallery.com>
